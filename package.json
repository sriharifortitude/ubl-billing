{
  "name": "ubl-billing",
  "version": "0.1.0",
  "description": "Build, calculate, validate and parse EN 16931 electronic invoices (Peppol BIS Billing 3.0, UBL 2.1). Exact decimal arithmetic, rule IDs from the specification.",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "ubl-billing": "./dist/cli/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "decimal.js": "^10.4.3",
    "fast-xml-parser": "^4.5.1",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
